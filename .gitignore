# Godot 4+ specific ignores
.godot/
/android/

# SCons build artifacts
.sconsign.dblite
.sconf_temp
config.log
*.obj
*.o
*.lib
*.exp
*.ilk
*.pdb
*.idb
*.dll
*.exe
~*.dll

# Build output directories
bin/
build/

# Editor temp files
*.tmp

# Windows shortcuts
*.lnk

# Godot import metadata (regenerated on project open)
*.import

# Stray files
/s

.vscode/
.vs/
*.suo
*.user

/extension_api.json

# Build database (generated by SCons)
compile_commands.json

# Minecraft reference files (local only)
MCPipeline/

# .freebuff/ is the probe/tooling directory, and it is HALF repository content: the
# probe scripts, their helper scripts, scenes and marker shaders are cited by path from
# the docs and from source comments, so they belong in a clone. Everything else the
# probes produce - screenshots, crash reports, generated sheets, Godot caches - is
# scratch measured in hundreds of megabytes.
#
# The files the docs cite must therefore be ADDED (they are not ignored):
#   git add .freebuff/*.gd .freebuff/*.sh .freebuff/*.tscn .freebuff/*.gdshader
.freebuff/*
!.freebuff/*.gd
!.freebuff/*.sh
!.freebuff/*.tscn
!.freebuff/*.gdshader
!.freebuff/*.gdshaderinc
!.freebuff/*.md
# Scratch scripts written during a session stay scratch even though they are .py/.gd.
.freebuff/_*

# Python bytecode from the checker tools.
__pycache__/
*.pyc
