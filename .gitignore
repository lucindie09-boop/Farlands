# Godot 4+ specific ignores
.godot/
/android/

# SCons build artifacts
.sconsign.dblite
.sconf_temp
config.log
*.obj
*.o
*.lib
*.exp
*.ilk
*.pdb
*.idb
*.dll
*.exe
~*.dll

# Build output directories
bin/
build/

# Editor temp files
*.tmp

# Windows shortcuts
*.lnk

# Godot import metadata (regenerated on project open)
*.import

# Stray files
/s

.vscode/
.vs/
*.suo
*.user

/extension_api.json

# Build database (generated by SCons)
compile_commands.json

# Minecraft reference files (local only)
MCPipeline/

# .freebuff/ is the LOCAL probe playground: scratch scripts a session writes and
# throws away, plus screenshots, crash reports, generated sheets and Godot
# caches. None of it belongs in a clone.
#
# The probe scripts the documentation actually cites as evidence live in
# probes/ and are tracked normally; docs/probes.md indexes them. That split is
# why this whole directory can be one line.
.freebuff/

# Python bytecode from the checker tools.
__pycache__/
*.pyc
