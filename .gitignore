# Godot 4+ specific ignores
.godot/
/android/

# SCons build artifacts
.sconsign.dblite
.sconf_temp
config.log
*.obj
*.o
*.lib
*.exp
*.ilk
*.pdb
*.idb
*.dll
*.exe
~*.dll

# Build output directories
bin/
build/

# Editor temp files
*.tmp

# Windows shortcuts
*.lnk

# Godot import metadata (regenerated on project open)
*.import
# Resource UIDs Godot writes beside every script and resource (4.4+). They are
# regenerated when the project is opened, so a clone does not need them; the few
# already in the tree stay tracked, as icon.svg.import does under the rule above.
*.uid

# Stray files
/s

.vscode/
.vs/
*.suo
*.user

/extension_api.json

# Build database (generated by SCons)
compile_commands.json

# Minecraft reference files (local only)
MCPipeline/

# Local scratch art: the archived originals ("old <name>", Piskel exports, numbered
# screenshots) and the two trial images the settings rows were tried with. They are
# working material, not shipped content, so they stay on disk without being cloned.
assets/textures/0Archive/
assets/textures/gui/buttontest.png
assets/textures/gui/slider_buttontest.png

# .freebuff/ is the LOCAL probe playground: scratch scripts a session writes and
# throws away, plus screenshots, crash reports, generated sheets and Godot
# caches. None of it belongs in a clone.
#
# The probe scripts the documentation actually cites as evidence live in
# probes/ and are tracked normally; docs/probes.md indexes them. That split is
# why this whole directory can be one line.
.freebuff/

# Python bytecode from the checker tools.
__pycache__/
*.pyc
