config_version=5

[application]
config/name="empty-project"

[display]

window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
occlusion_culling/jitter_projection=false
reflections/sky_reflections/texture_array_reflections=false
reflections/specular_occlusion/enabled=false
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/default_filters/texture_mipmap_bias=0.5
global_illumination/sdfgi/probe_ray_count=0
global_illumination/sdfgi/frames_to_converge=0
